#!/usr/bin/env python3
import hashlib
import json
import os
import shutil
import subprocess
import sys
import urllib.parse
import urllib.request
from pathlib import Path

from PySide6.QtCore import Qt, QObject, QProcess, QThread, Signal
from PySide6.QtGui import QIcon
from PySide6.QtWidgets import (
    QApplication,
    QHBoxLayout,
    QLabel,
    QListWidget,
    QListWidgetItem,
    QMessageBox,
    QProgressBar,
    QPushButton,
    QVBoxLayout,
    QWidget,
)

UPDATER_VERSION = "1.1.0"
CONFIG_FILE = Path("/etc/xuanos/updater.conf")
RELEASE_FILE = Path("/etc/xuanos-release")
OS_RELEASE = Path("/etc/os-release")
LOG_DIR = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "xuanos/logs"
DOWNLOAD_DIR = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "xuanos/downloads"
DEFAULT_MANIFEST_URL = "https://xuanos.pages.dev/manifest.json"
USER_AGENT = f"xuan-updater/{UPDATER_VERSION}"


def log_line(message: str) -> None:
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    with (LOG_DIR / "updater.log").open("a", encoding="utf-8") as handle:
        handle.write(message + "\n")


def load_manifest_url() -> str:
    if CONFIG_FILE.exists():
        for line in CONFIG_FILE.read_text(encoding="utf-8").splitlines():
            if line.startswith("MANIFEST_URL="):
                return line.split("=", 1)[1].strip()
    return DEFAULT_MANIFEST_URL


def local_version() -> str:
    if RELEASE_FILE.exists():
        for line in RELEASE_FILE.read_text(encoding="utf-8").splitlines():
            if line.startswith("XUANOS_VERSION="):
                return line.split("=", 1)[1].strip()
    if OS_RELEASE.exists():
        for line in OS_RELEASE.read_text(encoding="utf-8").splitlines():
            if line.startswith("IMAGE_VERSION="):
                return line.split("=", 1)[1].strip().strip('"')
    return "0.0.0"


def version_tuple(value: str):
    parts = []
    for chunk in value.split("."):
        digits = "".join(ch for ch in chunk if ch.isdigit())
        parts.append(int(digits) if digits else 0)
    while len(parts) < 3:
        parts.append(0)
    return tuple(parts[:3])


def fetch_manifest(url: str) -> dict:
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(request, timeout=15) as response:
        return json.loads(response.read().decode("utf-8"))


def sha256_of(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def notify(title: str, body: str) -> None:
    if shutil.which("notify-send"):
        subprocess.run(
            ["notify-send", "-i", "xuanos-logo", title, body],
            check=False,
        )


def run_check() -> int:
    url = load_manifest_url()
    current = local_version()
    try:
        manifest = fetch_manifest(url)
    except Exception as exc:
        log_line(f"check failed: {exc}")
        return 0

    latest = manifest["latest"]
    log_line(f"check: local={current} remote={latest['version']}")
    if version_tuple(latest["version"]) > version_tuple(current):
        notify(
            f"xuan OS 有新版本 {latest['version']}",
            "点击更新器查看更新内容并下载",
        )
    return 0


class DownloadWorker(QObject):
    progress = Signal(int, int)
    succeeded = Signal(str)
    failed = Signal(str)

    def __init__(self, url: str, dest: Path, expected_sha: str) -> None:
        super().__init__()
        self.url = url
        self.dest = dest
        self.expected_sha = expected_sha

    def run(self) -> None:
        try:
            request = urllib.request.Request(self.url, headers={"User-Agent": USER_AGENT})
            with urllib.request.urlopen(request, timeout=30) as response:
                total = int(response.headers.get("Content-Length", 0))
                got = 0
                DOWNLOAD_DIR.mkdir(parents=True, exist_ok=True)
                with self.dest.open("wb") as output:
                    while True:
                        chunk = response.read(256 * 1024)
                        if not chunk:
                            break
                        output.write(chunk)
                        got += len(chunk)
                        self.progress.emit(got, total)
            if self.expected_sha and not self.expected_sha.startswith("0000"):
                actual = sha256_of(self.dest)
                if actual != self.expected_sha:
                    self.failed.emit("校验和不匹配，文件可能已损坏，请重新下载")
                    return
            self.succeeded.emit(str(self.dest))
        except Exception as exc:
            self.failed.emit(str(exc))


class UpdaterWindow(QWidget):
    def __init__(self) -> None:
        super().__init__()
        self.setWindowTitle("xuan OS 更新")
        self.setMinimumSize(640, 560)
        self.manifest = None
        self.thread = None
        self.worker = None
        self._build_ui()
        self._refresh()

    def _build_ui(self) -> None:
        layout = QVBoxLayout(self)
        layout.setContentsMargins(28, 26, 28, 26)
        layout.setSpacing(16)

        header = QHBoxLayout()
        logo = QLabel()
        if Path("/usr/share/icons/xuanos/xuanos-logo.svg").exists():
            logo.setPixmap(QIcon("/usr/share/icons/xuanos/xuanos-logo.svg").pixmap(48, 48))
        header.addWidget(logo)
        title = QLabel("xuan OS 软件更新")
        title.setStyleSheet("font-size:22px;font-weight:700;")
        header.addWidget(title)
        header.addStretch(1)
        layout.addLayout(header)

        self.status_label = QLabel("正在检查更新…")
        self.status_label.setStyleSheet("font-size:15px;color:#5a6b82;")
        layout.addWidget(self.status_label)

        notes_title = QLabel("更新内容")
        notes_title.setStyleSheet("font-size:15px;font-weight:700;")
        layout.addWidget(notes_title)

        self.notes = QListWidget()
        layout.addWidget(self.notes, 1)

        self.progress = QProgressBar()
        self.progress.setVisible(False)
        layout.addWidget(self.progress)

        buttons = QHBoxLayout()
        self.pkg_btn = QPushButton("立即更新系统")
        self.pkg_btn.setStyleSheet(
            "background:#0078d4;color:#fff;border:none;border-radius:10px;padding:12px 20px;font-weight:700;"
        )
        self.pkg_btn.clicked.connect(self._package_update)
        self.iso_btn = QPushButton("下载完整 ISO 镜像")
        self.iso_btn.setStyleSheet(
            "background:#eef3fa;color:#0078d4;border:1px solid #0078d4;border-radius:10px;padding:12px 20px;font-weight:700;"
        )
        self.iso_btn.clicked.connect(self._download_iso)
        close_btn = QPushButton("关闭")
        close_btn.setStyleSheet("padding:12px 20px;border-radius:10px;")
        close_btn.clicked.connect(self.close)
        buttons.addWidget(self.pkg_btn)
        buttons.addWidget(self.iso_btn)
        buttons.addStretch(1)
        buttons.addWidget(close_btn)
        layout.addLayout(buttons)

    def _refresh(self) -> None:
        try:
            self.manifest = fetch_manifest(load_manifest_url())
        except Exception as exc:
            self.status_label.setText(f"无法连接更新服务器：{exc}")
            self.pkg_btn.setEnabled(False)
            self.iso_btn.setEnabled(False)
            return

        latest = self.manifest["latest"]
        current = local_version()
        has_update = version_tuple(latest["version"]) > version_tuple(current)
        if has_update:
            self.status_label.setText(
                f"发现新版本：当前 {current} → 最新 {latest['version']}（{latest['release_date']}）"
            )
        else:
            self.status_label.setText(f"当前系统已是最新版本 {current}")
        self.notes.clear()
        for note in latest.get("release_notes", []):
            self.notes.addItem(QListWidgetItem(note))

    def _package_update(self) -> None:
        latest = self.manifest["latest"]
        command = latest.get("package_update", {}).get("command", "xuan-ctl update")
        if shutil.which("konsole"):
            QProcess.startDetached("konsole", ["-e"] + command.split())
        else:
            QProcess.startDetached(command.split()[0], command.split()[1:])

    def _download_iso(self) -> None:
        latest = self.manifest["latest"]
        iso = latest["iso"]
        base = load_manifest_url()
        full_url = urllib.parse.urljoin(base, iso["url"])
        dest = DOWNLOAD_DIR / iso["filename"]

        self.progress.setVisible(True)
        self.progress.setValue(0)
        self.iso_btn.setEnabled(False)

        self.thread = QThread()
        self.worker = DownloadWorker(full_url, dest, iso.get("sha256", ""))
        self.worker.moveToThread(self.thread)
        self.thread.started.connect(self.worker.run)
        self.worker.progress.connect(self._on_progress)
        self.worker.succeeded.connect(self._on_downloaded)
        self.worker.failed.connect(self._on_download_failed)
        self.worker.succeeded.connect(self.thread.quit)
        self.worker.failed.connect(self.thread.quit)
        self.thread.finished.connect(self.worker.deleteLater)
        self.thread.start()

    def _on_progress(self, got: int, total: int) -> None:
        if total > 0:
            self.progress.setMaximum(total)
            self.progress.setValue(got)

    def _on_downloaded(self, path: str) -> None:
        self.iso_btn.setEnabled(True)
        QMessageBox.information(
            self,
            "下载完成",
            f"镜像已通过校验，保存在：\n{path}\n可用于制作启动盘或离线安装。",
        )

    def _on_download_failed(self, reason: str) -> None:
        self.iso_btn.setEnabled(True)
        self.progress.setVisible(False)
        QMessageBox.warning(self, "下载失败", reason)


def main() -> int:
    mode = sys.argv[1] if len(sys.argv) > 1 else "gui"
    if mode == "check":
        return run_check()

    app = QApplication([])
    app.setApplicationName("xuan-updater")
    window = UpdaterWindow()
    window.show()
    return app.exec()


if __name__ == "__main__":
    raise SystemExit(main())
